<h1><%= @course.name %></h1>
<p>von <%= @course.creator.username %></p>
<p><%= course_date(@course.start_date) %> – <%= course_date(@course.end_date) %></p>
<p><%= simple_format @course.description %></p>
<p>Maximal <%= @course.max_participants %> Teilnehmende</p>

<% if policy(@course).update? %>
  <%= link_to "Bearbeiten", edit_course_path(@course) %>
<% end %>

<% if policy(@course).destroy? %>
  <%= button_to "Löschen", @course, method: :delete,
        data: { turbo_confirm: "Kurs wirklich löschen?" } %>
<% end %>

<p><strong><%= @course.free_places %> von <%= @course.max_participants %> Plätzen frei</strong></p>

<% if @course.bookable_by?(Current.user) %>
  <%= link_to "Kurs buchen", new_course_booking_path(@course) %>
<% elsif @course.full? %>
  <p>Dieser Kurs ist ausgebucht.</p>
<% elsif Current.user && @course.creator_id == Current.user.id %>
  <p>Das ist dein eigener Kurs.</p>
<% elsif Current.user %>
  <p>Du hast diesen Kurs bereits gebucht.</p>
<% else %>
  <%= link_to "Zum Buchen anmelden", new_session_path %>
<% end %>

<%= link_to "Zurück", courses_path %>