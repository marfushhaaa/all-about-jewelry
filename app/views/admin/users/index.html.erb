<h1>Alle Benutzer</h1>

<table>
  <tr>
    <th>Username</th>
    <th>E-Mail</th>
    <th>Rolle</th>
    <th></th>
  </tr>
  <% @users.each do |user| %>
    <tr>
      <td><%= user.username %></td>
      <td><%= user.email_address %></td>
      <td><%= user.role %></td>
      <td>
        <% if policy(user).destroy? %>
          <%= button_to "Löschen", admin_user_path(user),
                method: :delete,
                data: { turbo_confirm: "#{user.username} wirklich löschen?" } %>
        <% end %>
      </td>
    </tr>
  <% end %>
</table>

<% @audits.each do |audit| %>
  <li>
    <%= l audit.created_at, format: :short %> —
    <%= audit.user&.username || "System" %>
    <%= audit.action %>
    <%= audit.auditable_type %>
    <%= audit.audited_changes.keys.join(", ") %>
  </li>
<% end %>