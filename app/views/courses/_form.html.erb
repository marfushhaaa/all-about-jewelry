<%= form_with model: @course, class: "form-grid" do |f| %>
  <% if @course.errors.any? %>
    <div class="form-errors">
      <strong>Der Kurs konnte nicht gespeichert werden:</strong>
      <ul>
        <% @course.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, "Kursname" %>
    <%= f.text_field :name, required: true, maxlength: 100, placeholder: "z. B. Perlenarmband für Anfänger" %>
  </div>

  <div class="field">
    <%= f.label :description, "Beschreibung" %>
    <%= f.text_area :description, rows: 6, placeholder: "Was lernen die Teilnehmenden? Was wird mitgebracht?" %>
  </div>

  <div class="two">
    <div class="field">
      <%= f.label :start_date, "Start" %>
      <%= f.datetime_field :start_date %>
    </div>

    <div class="field">
      <%= f.label :end_date, "Ende" %>
      <%= f.datetime_field :end_date %>
      <p class="hint">Muss nach dem Start liegen.</p>
    </div>
  </div>

  <div class="field">
    <%= f.label :max_participants, "Maximale Teilnehmerzahl" %>
    <%= f.number_field :max_participants, min: 1, placeholder: "leer = unbegrenzt" %>
  </div>

  <div class="form-actions">
    <%= f.submit @course.new_record? ? "Kurs erstellen" : "Änderungen speichern", class: "submit-primary" %>
    <%= link_to "Abbrechen", @course.new_record? ? courses_path : @course %>
  </div>
<% end %>
