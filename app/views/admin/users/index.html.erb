<div class="container">
  <div class="page-head">
    <h1>Alle Benutzer</h1>
    <p>Verwaltung der Konten und Aktivitätsprotokoll</p>
  </div>

  <div class="panel">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Username</th>
            <th>E-Mail</th>
            <th>Rolle</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><span class="who"><span class="avatar"><%= avatar_initial(user) %></span><%= user.username %></span></td>
              <td><%= user.email_address %></td>
              <td>
                <span class="pill"><%= user.role %></span>
                <% if user.admin? %><span class="pill pill-terra">admin</span><% end %>
              </td>
              <td style="text-align: right">
                <% if policy(user).destroy? %>
                  <%= button_to "Löschen", admin_user_path(user),
                        method: :delete, form_class: "inline-action",
                        data: { turbo_confirm: "#{user.username} wirklich löschen?" } %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="panel">
    <h2>Aktivitätsprotokoll</h2>
    <% if @audits.empty? %>
      <p class="muted">Noch keine Aktivitäten.</p>
    <% else %>
      <ul class="timeline">
        <% @audits.each do |audit| %>
          <li>
            <strong><%= audit.user&.username || "System" %></strong> <%= audit_sentence(audit) %>
            <span class="when"><%= de_short(audit.created_at) %> Uhr</span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
