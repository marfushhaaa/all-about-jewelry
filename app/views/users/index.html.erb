<div class="container">
  <div class="page-head row">
    <div>
      <h1>Community</h1>
      <p>Alle registrierten Mitglieder</p>
    </div>
    <%= link_to "Neues Konto", new_user_path, class: "btn btn-primary" %>
  </div>

  <div class="panel">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>E-Mail</th>
            <th>Rolle</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td class="muted"><%= user.id %></td>
              <td><span class="who"><span class="avatar"><%= avatar_initial(user) %></span><%= user.username %></span></td>
              <td><%= user.email_address %></td>
              <td><span class="pill"><%= user.role %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
