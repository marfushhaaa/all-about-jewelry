<% content_for :auth, true %>
<% content_for :title, "Neues Passwort · AllAroundJewelry" %>

<div class="auth">
  <div class="auth-visual art art-2">
    <%= link_to root_path, class: "logo light" do %>
      <span class="sprig"><%= icon(:leaf) %></span><span><span class="a">AllAround</span><span class="j">Jewelry</span></span>
    <% end %>
    <div>
      <p class="quote">„Neu auffädeln und weitermachen.“</p>
    </div>
  </div>

  <div class="auth-form">
    <div class="inner">
      <h1>Neues Passwort festlegen</h1>
      <p class="lead">Wähle ein neues Passwort für dein Konto.</p>

      <div class="flash-stack">
        <%= tag.div(flash[:alert], class: "flash flash-alert") if flash[:alert] %>
      </div>

      <%= form_with url: password_path(params[:token]), method: :put, class: "form-grid" do |form| %>
        <div class="field">
          <%= form.label :password, "Neues Passwort" %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: "Neues Passwort", maxlength: 72 %>
        </div>
        <div class="field">
          <%= form.label :password_confirmation, "Passwort bestätigen" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Passwort wiederholen", maxlength: 72 %>
        </div>
        <%= form.submit "Passwort speichern", class: "submit-primary" %>
      <% end %>
    </div>
  </div>
</div>
