<% if authenticated? %>
  <h1>Welcome, <%= Current.user.username %></h1>
<% else %>
  <h1>This is the index page</h1>
<% end %>
<%= link_to 'Details page', '/courses/details' %>
<% if policy(Course).create? %>
  <%= link_to "Neuen Kurs erstellen", new_course_path %>
<% end %>
<% @courses.each do |course| %>
  <div>
    <h2><%= link_to course.name, course %></h2>
    <p><%= course_date(course.start_date) %> · von <%= course.creator.username %></p>
  </div>
<% end %>